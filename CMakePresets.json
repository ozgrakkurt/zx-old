{
  "version": 3,
  "configurePresets": [
    {
      "name": "base-config",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "debug",
      "inherits": "base-config",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base-config",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "optimized-debug",
      "inherits": "base-config",
      "binaryDir": "${sourceDir}/build/opt-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "None",
        "CMAKE_C_FLAGS": "-O2 -g",
        "CMAKE_CXX_FLAGS": "-O2 -g"
      }
    },
    {
      "name": "fuzzinger",
      "binaryDir": "${sourceDir}/build/fuzzinger",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/../honggfuzz/hfuzz_cc/hfuzz-clang",
        "CMAKE_CXX_COMPILER": "${sourceDir}/../honggfuzz/hfuzz_cc/hfuzz-clang++",
        "CMAKE_BUILD_TYPE": "None",
        "CMAKE_C_FLAGS": "-O2 -g -fsanitize=address -fsanitize=undefined",
        "CMAKE_CXX_FLAGS": "-O2 -g -fsanitize=address -fsanitize=undefined",
        "CMAKE_LINK_FLAGS": "-fsanitize=address -fsanitize=undefined"
      }
    }
  ]
}
